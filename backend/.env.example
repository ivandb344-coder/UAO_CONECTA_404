MONGODB_URL=mongodb://localhost:27017
DB_NAME=uao_conecta
JWT_SECRET=replace-with-a-long-random-secret

# Password recovery email. Gmail App Passwords require 2-Step Verification.
# Use an App Password here, never the normal Google account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=UAO Conecta <your-sender@gmail.com>
